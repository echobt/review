# Copy to .env (gitignored). Never commit real values. Defaults match docker-compose.yml.
DATABASE_URL=postgres://review_app:review_app@localhost:5432/review
MIGRATION_DATABASE_URL=postgres://review:review@localhost:5432/review
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=review
# Local objectstore credentials (docker-compose defaults; never use in prod)
AWS_ACCESS_KEY_ID=review
AWS_SECRET_ACCESS_KEY=review-local-only
AWS_REGION=us-east-1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
REVIEW_API_URL=http://localhost:8080
# REVIEW_API_KEY=
# GITHUB_WEBHOOK_SECRET=         # or GITHUB_WEBHOOK_SECRET_FILE=/path
# OPENROUTER_API_KEY=            # or OPENROUTER_API_KEY_FILE=/path/to/keyfile
# LOCAL_KMS_MASTER_KEY_FILE=     # dev LocalKms master key (32 bytes base64) for indexer; prod: VAULT_ADDR + VAULT_TOKEN(_FILE)
# DEV_API_KEY=                   # RUNTIME_MODE=memory only
