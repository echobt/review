{
  "name": "review-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build",
    "test": "pnpm -r test",
    "validate:model": "node scripts/validate-model.ts",
    "check:mermaid": "node scripts/check-mermaid.mjs",
    "db:migrate": "pnpm --filter @review/db migrate"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@review/core": "workspace:*",
    "@review/models": "workspace:*",
    "zod": "^4.1.0"
  }
}
